# =============================================================================
# PRODUCTION — example env file (safe to commit)
# Set these vars in Vercel dashboard under Settings > Environment Variables.
# =============================================================================

APP_ENV=production
NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://liveitwithbardo.vercel.app

ENABLE_ADMIN=false

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-hex-string

NEXT_PUBLIC_SHOW_PROMO_BAR=true
NEXT_PUBLIC_PROMO_TARGET_DATE=2026-05-15T09:00:00Z
NEXT_PUBLIC_SHOW_CHAT_AGENT=true
