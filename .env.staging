# =============================================================================
# STAGING — deployable env file
# Deploy to Vercel staging environment or use locally with:
#   NODE_ENV=production APP_ENV=staging next start
#
# DO NOT commit this file if it contains real credentials.
# Use .env.staging.example as the committed reference.
# =============================================================================

# ── Environment identity ──────────────────────────────────────────────────────
APP_ENV=staging
NODE_ENV=production

# ── App URL (used for metadataBase and absolute links) ────────────────────────
# Update this to your actual Vercel staging preview URL.
NEXT_PUBLIC_APP_URL=https://project-27aiy-git-staging.vercel.app

# ── Admin access ──────────────────────────────────────────────────────────────
# Enables /admin/* routes and /api/admin/* endpoints in staging.
ENABLE_ADMIN=true

# ── Staging login credentials (server-side only — never NEXT_PUBLIC_) ─────────
# These are used by /api/auth/login to validate the login form.
# Change these before deploying to a shared environment.
STAGING_LOGIN_USERNAME=admin
STAGING_LOGIN_PASSWORD=staging-pass-change-me

# ── Session signing secret (server-side only) ─────────────────────────────────
# HMAC-SHA256 key for signing session cookies.
# Generated with: openssl rand -hex 32
# Replace with your own secret — this value is for local staging only.
SESSION_SECRET=5be818f1b7bf154ce37d8207f51bf5eb6afb645ab3cf07aad229697ae29834c6

# ── AIESEC GIS API ────────────────────────────────────────────────────────────
# access_token for fetching live Bardo committee opportunity data.
# Leave empty to use static fallback data.
AIESEC_GIS_TOKEN=s0rgcJcA6JtdGKATYGdXcdb_y2f80T1bmt2hzfY1BWo

# ── Feature flags (client-safe) ───────────────────────────────────────────────
# PromoBar countdown banner
NEXT_PUBLIC_SHOW_PROMO_BAR=true
NEXT_PUBLIC_PROMO_TARGET_DATE=2026-05-15T09:00:00Z

# Navbar link filtering — mirrors production nav (Home + Projects only)
# Decoupled from APP_ENV so staging can show the same nav as production
# without affecting middleware route-guarding.
NEXT_PUBLIC_PRODUCTION_NAV=true

# ChatAgent widget
NEXT_PUBLIC_SHOW_CHAT_AGENT=true
