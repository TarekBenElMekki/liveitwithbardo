# =============================================================================
# STAGING — example env file (safe to commit)
# Copy to .env.staging and fill in real values before deploying.
# =============================================================================

APP_ENV=staging
NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://your-staging-url.vercel.app

ENABLE_ADMIN=true

# AIESEC GIS API — direct opportunity data source
# Fetches open opportunities for AIESEC in Bardo (committee 1270), programmes GV/GT/GE.
# Leave empty to use static fallback data.
AIESEC_GIS_TOKEN=

NEXT_PUBLIC_SHOW_PROMO_BAR=false
NEXT_PUBLIC_PROMO_TARGET_DATE=2026-05-15T09:00:00Z
NEXT_PUBLIC_SHOW_CHAT_AGENT=true
